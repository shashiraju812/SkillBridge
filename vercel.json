{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/practicals/(.*\\.(html|css|js))",
      "dest": "/practicals/$1"
    },
    {
      "src": "/xml/(.*)",
      "dest": "/xml/$1"
    },
    {
      "src": "/wtproject/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
